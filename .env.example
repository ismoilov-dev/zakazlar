# Production & Contabo VPS Settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=your-domain.com,your-vps-ip,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://your-domain.com,https://your-domain.com,http://your-vps-ip

# PostgreSQL Database Configuration
POSTGRES_DB=sales_bot_db
POSTGRES_USER=sales_bot_user
POSTGRES_PASSWORD=strong_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

