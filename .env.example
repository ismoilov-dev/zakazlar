# Production & Contabo VPS Settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=generate-a-secure-random-secret-key-here
DJANGO_DEBUG=false
# HTTPS control (set false when accessing via HTTP/IP without domain/SSL)
DJANGO_USE_HTTPS=false
DJANGO_ALLOWED_HOSTS=169.58.72.177,localhost,127.0.0.1
DJANGO_CSRF_TRUSTED_ORIGINS=http://169.58.72.177:8080

# PostgreSQL Database Configuration
POSTGRES_DB=sales_bot_db
POSTGRES_USER=sales_bot_user
POSTGRES_PASSWORD=strong_postgres_password_here
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRsTUVwxyZ

# Google Sheets Webhook Secret & Sheet ID
SHEETS_WEBHOOK_SECRET=your_sheets_webhook_secret_here
GOOGLE_SHEET_ID=your_google_sheet_id_here

# Google Service Account Credentials
# Eslatma: systemd EnvironmentFile probel va qo'shtirnoqli qiymatlarni to'g'ri o'qimaydi,
# shuning uchun JSON'ni faylga yozib GOOGLE_SERVICE_ACCOUNT_FILE orqali berish tavsiya etiladi.
GOOGLE_SERVICE_ACCOUNT_FILE=credentials/service-account.json
GOOGLE_SERVICE_ACCOUNT_JSON=



