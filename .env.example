# Production & Amvera Cloud Settings
DJANGO_ENV=production
DJANGO_SECRET_KEY=change-this-to-a-long-random-secret-key
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=*
DJANGO_CSRF_TRUSTED_ORIGINS=https://your-app-name.amvera.io

# PostgreSQL Database Configuration (from Amvera PostgreSQL service)
POSTGRES_DB=amvera
POSTGRES_USER=username
POSTGRES_PASSWORD=password
POSTGRES_HOST=db-host.amvera.io
POSTGRES_PORT=5432

# Telegram Bot Token from @BotFather
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
