# Copy this file to `.env`, then fill every placeholder with a local value.
# Do not put real secrets in this example file.

DJANGO_ENV=development
DJANGO_SECRET_KEY=replace-with-a-long-random-django-secret-key
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Local PostgreSQL server configuration.
POSTGRES_DB=sales_bot
POSTGRES_USER=sales_bot
POSTGRES_PASSWORD=replace-with-a-local-postgres-password
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432

# Telegram bot is not started until its dedicated implementation stage.
TELEGRAM_BOT_TOKEN=replace-with-your-botfather-token
